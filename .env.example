# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_SHEET_WEBHOOK: Optional URL for syncing contact form submissions to a Google Sheet (both VITE prefix and plain suffix supported).
GOOGLE_SHEET_WEBHOOK="https://script.google.com/macros/s/..."
VITE_GOOGLE_SHEET_WEBHOOK="https://script.google.com/macros/s/..."

# VITE_EXCEL_WEBHOOK_URL: Optional URL for syncing contact form submissions to a Microsoft Excel online sheet (e.g., via Power Automate Webhook).
VITE_EXCEL_WEBHOOK_URL=""

# Mail and SMTP configuration for automated contact form replies (Microsoft 365)
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USER="no-reply@abdullahmahiofficial.com"
SMTP_PASS="bbsqsxbrtmxxbdcm"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

